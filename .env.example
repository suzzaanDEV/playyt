# PlayYT environment variables
# Copy this file to .env and fill in your values, then source it:
#   cp .env.example .env
#   set -a; source .env; set +a
#   playyt

# Google OAuth 2.0 client credentials (from Google Cloud Console)
# Get these at https://console.cloud.google.com/
PLAYYT_CLIENT_ID="your-client-id.apps.googleusercontent.com"
PLAYYT_CLIENT_SECRET="your-client-secret"

# Optional: override defaults
# PLAYYT_DEBUG=1
# PLAYYT_VENV=$HOME/.local/playyt/.venv
